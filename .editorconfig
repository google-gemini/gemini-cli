  35765,94:             "new_string": "  const frontmatter = result.data;\n\n  if (frontmatter.kind === 'remote') {\n    return [\n      {\n        ...frontmatter,\n        kind: 'remote',\n      },\n    ];\n  }\n\n  if (frontmatter.kind === 'external') {\n    return [\n      {\n        ...frontmatter,\n        kind: 'external',\n      },\n    ];\n  }\n\n  // Construct the local agent definition\n  return [\n    {\n      ...frontmatter,\n      kind: 'local',\n      system_prompt: body.trim(),\n    },\n  ];\n}\n",
