{
  "name": "zoe-monorepo",
  "version": "0.1.0",
  "description": "Zoe — Engineering, not autocomplete.",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "private": true,
  "bin": {
    "zoe": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "build": "npm run build --workspace=@zoe/core && npm run build --workspace=zoe",
    "start": "node packages/cli/dist/index.js",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces",
    "clean": "rm -rf packages/*/dist"
  },
  "overrides": {
    "ink": "npm:@jrichman/ink@6.6.9"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.0",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "ink": "npm:@jrichman/ink@6.6.9",
    "react": "19.2.4"
  }
}
